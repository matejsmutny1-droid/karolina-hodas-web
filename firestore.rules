rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in [
          "karolinahodas@gmail.com",
          "matejsmutny1@gmail.com"
        ];
    }

    function formatMinute(minute) {
      let hour = math.floor(minute / 60);
      let remainder = minute % 60;
      return (hour < 10 ? "0" : "") + string(hour)
        + ":" + (remainder < 10 ? "0" : "") + string(remainder);
    }

    function validAvailability(data) {
      return data.keys().hasOnly(["datum", "cas", "trvanie", "startMinute", "endMinute"])
        && data.keys().hasAll(["datum", "cas", "trvanie", "startMinute", "endMinute"])
        && data.datum is string
        && data.datum.matches("^\\d{4}-\\d{2}-\\d{2}$")
        && data.cas is string
        && data.cas.matches("^([01]\\d|2[0-3]):[0-5]\\d$")
        && data.trvanie is int
        && data.trvanie >= 15
        && data.trvanie <= 720
        && data.startMinute is int
        && data.startMinute >= 0
        && data.startMinute < 1440
        && data.cas == formatMinute(data.startMinute)
        && data.endMinute is int
        && data.endMinute > data.startMinute
        && data.endMinute <= 1440
        && data.endMinute - data.startMinute == data.trvanie;
    }

    function validPause(serviceDuration, pause) {
      return (serviceDuration == 30 && pause == 15)
        || ((serviceDuration == 150 || serviceDuration == 180) && pause == 30)
        || (serviceDuration != 30 && serviceDuration != 150 && serviceDuration != 180 && pause == 20);
    }

    function sequentialBlocks(keys) {
      return keys is list
        && keys.size() >= 1
        && keys.size() <= 18
        && keys.toSet().size() == keys.size()
        && (keys.size() <= 1 || keys[1] == keys[0] + 15) &&
      (keys.size() <= 2 || keys[2] == keys[1] + 15) &&
      (keys.size() <= 3 || keys[3] == keys[2] + 15) &&
      (keys.size() <= 4 || keys[4] == keys[3] + 15) &&
      (keys.size() <= 5 || keys[5] == keys[4] + 15) &&
      (keys.size() <= 6 || keys[6] == keys[5] + 15) &&
      (keys.size() <= 7 || keys[7] == keys[6] + 15) &&
      (keys.size() <= 8 || keys[8] == keys[7] + 15) &&
      (keys.size() <= 9 || keys[9] == keys[8] + 15) &&
      (keys.size() <= 10 || keys[10] == keys[9] + 15) &&
      (keys.size() <= 11 || keys[11] == keys[10] + 15) &&
      (keys.size() <= 12 || keys[12] == keys[11] + 15) &&
      (keys.size() <= 13 || keys[13] == keys[12] + 15) &&
      (keys.size() <= 14 || keys[14] == keys[13] + 15) &&
      (keys.size() <= 15 || keys[15] == keys[14] + 15) &&
      (keys.size() <= 16 || keys[16] == keys[15] + 15) &&
      (keys.size() <= 17 || keys[17] == keys[16] + 15);
    }

    function blocksBelongToReservation(blocks, keys, bookingId) {
      return blocks is map
      && (keys.size() <= 0 || blocks.get(string(keys[0]), "") == bookingId) &&
      (keys.size() <= 1 || blocks.get(string(keys[1]), "") == bookingId) &&
      (keys.size() <= 2 || blocks.get(string(keys[2]), "") == bookingId) &&
      (keys.size() <= 3 || blocks.get(string(keys[3]), "") == bookingId) &&
      (keys.size() <= 4 || blocks.get(string(keys[4]), "") == bookingId) &&
      (keys.size() <= 5 || blocks.get(string(keys[5]), "") == bookingId) &&
      (keys.size() <= 6 || blocks.get(string(keys[6]), "") == bookingId) &&
      (keys.size() <= 7 || blocks.get(string(keys[7]), "") == bookingId) &&
      (keys.size() <= 8 || blocks.get(string(keys[8]), "") == bookingId) &&
      (keys.size() <= 9 || blocks.get(string(keys[9]), "") == bookingId) &&
      (keys.size() <= 10 || blocks.get(string(keys[10]), "") == bookingId) &&
      (keys.size() <= 11 || blocks.get(string(keys[11]), "") == bookingId) &&
      (keys.size() <= 12 || blocks.get(string(keys[12]), "") == bookingId) &&
      (keys.size() <= 13 || blocks.get(string(keys[13]), "") == bookingId) &&
      (keys.size() <= 14 || blocks.get(string(keys[14]), "") == bookingId) &&
      (keys.size() <= 15 || blocks.get(string(keys[15]), "") == bookingId) &&
      (keys.size() <= 16 || blocks.get(string(keys[16]), "") == bookingId) &&
      (keys.size() <= 17 || blocks.get(string(keys[17]), "") == bookingId);
    }

    function addonsBelongToService(addons, catalogAddons) {
      return (addons.size() == 0)
        || (addons.size() == 1 && addons[0] in catalogAddons)
        || (addons.size() == 2 && addons[0] in catalogAddons && addons[1] in catalogAddons);
    }

    function validPublicBooking(bookingId) {
      let data = request.resource.data;
      let schedule = get(/databases/$(database)/documents/dostupnost/$(data.slotId)).data;
      let catalog = get(/databases/$(database)/documents/bookingCatalog/$(data.serviceId)).data;
      let locks = getAfter(/databases/$(database)/documents/rezervacneZamky/$(data.datum)).data;
      let firstAddonDuration = data.doplnky.size() > 0 && data.doplnky[0] in catalog.addons
        ? catalog.addons[data.doplnky[0]].trvanie : 0;
      let secondAddonDuration = data.doplnky.size() > 1 && data.doplnky[1] in catalog.addons
        ? catalog.addons[data.doplnky[1]].trvanie : 0;
      let firstAddonPrice = data.doplnky.size() > 0 && data.doplnky[0] in catalog.addons
        ? catalog.addons[data.doplnky[0]].cena : 0;
      let secondAddonPrice = data.doplnky.size() > 1 && data.doplnky[1] in catalog.addons
        ? catalog.addons[data.doplnky[1]].cena : 0;

      return data.keys().hasOnly([
          "datum", "slotId", "serviceId", "cas", "startMinute",
          "trvanieRezervacie", "prestavka", "blockKeys", "meno",
          "telefon", "email", "masaz", "doplnky", "cenaSpolu", "vytvorene"
        ])
        && data.keys().hasAll([
          "datum", "slotId", "serviceId", "cas", "startMinute",
          "trvanieRezervacie", "prestavka", "blockKeys", "meno",
          "telefon", "email", "masaz", "doplnky", "cenaSpolu"
        ])
        && data.datum is string
        && data.datum.matches("^\\d{4}-\\d{2}-\\d{2}$")
        && data.slotId is string
        && data.serviceId is string
        && data.cas is string
        && data.startMinute is int
        && data.startMinute >= 0
        && data.startMinute < 1440
        && data.startMinute % 15 == 0
        && data.cas == formatMinute(data.startMinute)
        && data.trvanieRezervacie is int
        && data.trvanieRezervacie >= 30
        && data.trvanieRezervacie <= 240
        && data.prestavka is int
        && validPause(data.trvanieRezervacie, data.prestavka)
        && data.doplnky is list
        && data.doplnky.size() <= 2
        && data.doplnky.toSet().size() == data.doplnky.size()
        && addonsBelongToService(data.doplnky, catalog.addons)
        && data.meno is string
        && data.meno.size() >= 2
        && data.meno.size() <= 100
        && data.telefon is string
        && data.telefon.matches("^[0-9+ ]{9,25}$")
        && data.email is string
        && data.email.size() <= 254
        && data.email.matches("^[^@ ]+@[^@ ]+\\.[^@ ]+$")
        && data.masaz is string
        && data.masaz == catalog.masaz
        && data.cenaSpolu is int
        && data.trvanieRezervacie == catalog.trvanie
          + firstAddonDuration + secondAddonDuration
        && data.cenaSpolu == catalog.cena
          + firstAddonPrice + secondAddonPrice
        && validAvailability(schedule)
        && schedule.datum == data.datum
        && data.startMinute >= schedule.startMinute
        && data.startMinute + data.trvanieRezervacie + data.prestavka <= schedule.endMinute
        && sequentialBlocks(data.blockKeys)
        && data.blockKeys[0] == data.startMinute
        && data.blockKeys.size() * 15 >= data.trvanieRezervacie + data.prestavka
        && (data.blockKeys.size() - 1) * 15 < data.trvanieRezervacie + data.prestavka
        && locks.datum == data.datum
        && locks.lastBookingId == bookingId
        && blocksBelongToReservation(locks.blocks, data.blockKeys, bookingId);
    }

    function validPublicLockUpdate(date) {
      let bookingId = request.resource.data.lastBookingId;
      let booking = getAfter(/databases/$(database)/documents/rezervacie/$(bookingId)).data;
      let blockDiff = request.resource.data.blocks.diff(resource.data.blocks);

      return request.resource.data.keys().hasOnly(["datum", "blocks", "lastBookingId"])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["blocks", "lastBookingId"])
        && request.resource.data.datum == date
        && request.resource.data.blocks is map
        && booking.datum == date
        && booking.blockKeys is list
        && booking.blockKeys.size() >= 1
        && blockDiff.addedKeys().size() == booking.blockKeys.size()
        && blockDiff.removedKeys().size() == 0
        && blockDiff.changedKeys().size() == 0
        && blocksBelongToReservation(request.resource.data.blocks, booking.blockKeys, bookingId);
    }

    match /dostupnost/{slotId} {
      allow read: if true;
      allow create, update: if isAdmin() && validAvailability(request.resource.data);
      allow delete: if isAdmin();
    }

    match /rezervacneZamky/{date} {
      allow read: if true;
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(["datum", "blocks", "lastBookingId"])
        && request.resource.data.datum == date
        && request.resource.data.blocks is map;
      allow update: if isAdmin() || validPublicLockUpdate(date);
      allow delete: if isAdmin();
    }

    match /rezervacie/{bookingId} {
      allow read: if isAdmin();
      allow create: if isAdmin() || validPublicBooking(bookingId);
      allow update, delete: if isAdmin();
    }

    match /bookingCatalog/{serviceId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Legacy collection: admin-only while old records are migrated.
    match /terminy/{slotId} {
      allow read, write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
